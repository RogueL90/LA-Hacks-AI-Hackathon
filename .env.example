# Copy to .env and fill in. Never commit .env.

# ASI:One LLM (https://asi1.ai/developer)
ASI_ONE_API_KEY=

# Agentverse API key (agentverse.ai -> Profile -> API Keys); used to register agent mailboxes
AGENTVERSE_API_KEY=

# Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Sentry
SENTRY_DSN=

# Agent seeds: any long random string each. They fix each agent's address, so keep them secret and stable.
COORDINATOR_SEED=
SPACE_BUILDER_SEED=
ELDER_SEED=
BABY_SEED=
TRANSFORMER_SEED=
CLAIM_SEED=
PRODUCT_FINDER_SEED=
CART_SEED=
PAYMENT_VERIFIER_SEED=
INSURANCE_FILER_SEED=
RECOVERY_SEED=

# Ports
COORDINATOR_PORT=8200

# Space Service (Aditya)
SPACE_SERVICE_URL=http://127.0.0.1:8300


# Stripe TEST-mode keys for the service fee (sk_test_/pk_test_ only; live keys are refused)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
SERVICE_FEE_USD=4.99
