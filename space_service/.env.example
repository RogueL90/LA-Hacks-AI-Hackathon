ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium | high (more = slower, pricier, maybe more accurate)
ANTHROPIC_EFFORT=medium
SENTRY_DSN=
PUBLIC_BASE_URL=http://localhost:8000
VIEWER_BASE_URL=http://localhost:5173
CORS_ORIGINS=*
# 1 = /spaces/build returns the prebuilt demo space (until the real pipeline is ready)
USE_PREBUILT=1
# parallel (default, ~25 s): quick layout pass, then one objects call per room at the same time.
# single: one call for the whole home (~35 s at medium).
EXTRACT_MODE=parallel
ANTHROPIC_LAYOUT_EFFORT=low
ANTHROPIC_ROOM_EFFORT=low
ROOM_FRAMES=4
