ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5-1
# low | medium | high (more = slower, pricier, maybe more accurate)
ANTHROPIC_EFFORT=low
ANTHROPIC_PLAN_EFFORT=medium
SENTRY_DSN=
PUBLIC_BASE_URL=http://localhost:8000
VIEWER_BASE_URL=http://localhost:5173
CORS_ORIGINS=*
# 1 = /spaces/build returns the prebuilt demo space (until the real pipeline is ready)
USE_PREBUILT=1

# Speed: per-room calls at once and frames per room. 16 / 8 with ANTHROPIC_MODEL=claude-sonnet-5-5,
# rooms low, plan medium builds the 32 s demo tour in ~31-33 s with 13/13 key safety items.
ROOM_WORKERS=4
MAX_FRAMES_PER_ROOM=12
# Reuse the saved Space when the same video/photos are built again (keyed by file size + first 1 MB).
BUILD_CACHE=1
# A cache hit still takes at least this long (so a demo doesn't look canned).
CACHE_MIN_SECONDS=5
